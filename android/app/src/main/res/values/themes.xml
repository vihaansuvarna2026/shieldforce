<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MoneyVille" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Dark status-bar icons would vanish against the blue scrim. -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- Shown by androidx.core.splashscreen until the game has painted. -->
    <style name="Theme.MoneyVille.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MoneyVille</item>
    </style>

</resources>
