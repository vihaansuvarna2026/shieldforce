<?xml version="1.0" encoding="utf-8"?>
<!--
  The WebView fills the window; the scrim paints the brand colour behind the
  status bar, whose height is set from the window insets at runtime because
  apps draw edge to edge from Android 15 onwards.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background" />

    <View
        android:id="@+id/status_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/brand_blue" />

</FrameLayout>
