      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Emergency — I've been scammed",
      "short_name": "SOS",
      "url": "emergency.html",
      "description": "Call 1930 and the six response steps",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Training drills",
      "short_name": "Training",
