{
  "name": "Shield Force — Scam Defence",
  "short_name": "Shield Force",
  "description": "Scan suspicious messages, learn the scams that target the Indian Armed Forces community, and act fast when fraud happens. Works offline; nothing you type leaves your device.",
  "id": "/",
  "start_url": "index.html",
  "scope": ".",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#081020",
