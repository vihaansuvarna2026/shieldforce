{
  "name": "shieldforce",
  "productName": "Shield Force",
  "version": "1.0.0",
  "description": "Fraud protection, training and emergency response for the Indian Armed Forces community.",
  "main": "main.js",
  "author": "Shield Force",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --arm64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "in.shieldforce.app",
    "productName": "Shield Force",
    "directories": { "output": "dist" },
    "files": ["main.js", "site/**/*"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "hardenedRuntime": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Education"
    }
  }
}
